generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  USER
}

enum OrderStatus {
  ORDER_PLACED
  SHIPPING_TO_INDONESIA
  ARRIVED_IN_INDONESIA
  ARRIVED_AT_WAREHOUSE
  SHIPPED_TO_CUSTOMER
  ORDER_DELIVERED
}

enum PaymentStatus {
  NO_PAYMENT
  LUNAS
  DONE_DP
}

enum Eta {
  JAN
  FEB
  MAR
  APR
  MAY
  JUN
  JUL
  AUG
  SEP
  OCT
  NOV
  DEC
}

enum Format {
  HC
  PB
  BB
  SET
  SB
}

enum StockStatus {
  READY_STOCK
  PRE_ORDER
}

model Batch {
  id     String  @id @default(cuid())
  name   String  @unique
  orders Order[]
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String
  username     String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         Role     @default(USER)
  contact      String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Book {
  id        String      @id @default(cuid())
  title     String     @unique
  publisher String?
  info      String?
  image     String?
  price     Int
  stock     Int        @default(0)
  status    StockStatus @default(READY_STOCK)
  formats   Format[]   @default([])
  createdAt DateTime   @default(now())
  items     OrderItem[]
}

model Order {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  buyerId       String
  buyer         User          @relation(fields: [buyerId], references: [id])
  status        OrderStatus   @default(ORDER_PLACED)
  total         Int
  soldAt        DateTime      @default(now())
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id])
  eta           Eta
  dp            Int?
  remaining     Int?
  paymentStatus PaymentStatus @default(NO_PAYMENT)
  createdAt     DateTime      @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book   @relation(fields: [bookId], references: [id])
  quantity  Int
  unitPrice Int
  subtotal  Int
}