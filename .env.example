DATABASE_URL=""
# Koneksi direct (non-pooled) untuk migrasi Prisma. Neon: host TANPA `-pooler`.
DIRECT_URL=""
# Koneksi non-owner (role `app_user`) untuk query order sisi pembeli; tunduk pada
# Row-Level Security (lihat migrasi `_enable_rls_buyer_orders`). Neon: host pooled
# (`-pooler`). Jika kosong, app jatuh ke DATABASE_URL (owner) → RLS tidak aktif.
# Set password role di DB: `ALTER ROLE app_user WITH PASSWORD '<rahasia>';`
APP_DATABASE_URL=""
NEXTAUTH_URL=""
NEXTAUTH_SECRET=""
UPLOADTHING_TOKEN=""
# Admin seed untuk `prisma db seed`. Format: email|password|name; pisahkan beberapa dengan ;
# Contoh: ADMIN_SEED="admin@example.com|ganti-dengan-password-kuat|Nama Admin"
ADMIN_SEED=""
# Set 1 untuk melewati guardrail anti-prod pada db:migrate / db:seed
# SKIP_DB_GUARD="0"

# PostHog browser analytics
# NEXT_PUBLIC_POSTHOG_HOST harus lewat reverse proxy domain sendiri (issue #214):
# produksi: https://www.curatedbyder.store/ingest  (rewrite di next.config.mjs → us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://www.curatedbyder.store/ingest

# Sentry error tracking — PRODUCTION ONLY (Vercel scope Production).
# Isi NEXT_PUBLIC_SENTRY_DSN (+ SENTRY_AUTH_TOKEN untuk upload source map saat build)
# HANYA di Vercel Production. Local/staging biarkan kosong → Sentry disabled (no-op).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
