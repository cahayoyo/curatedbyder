DATABASE_URL=""
# Direct (non-pooled) connection for Prisma migrations. Neon: host WITHOUT `-pooler`.
DIRECT_URL=""
# Non-owner connection (role `app_user`) for buyer-side order queries; subject to
# Row-Level Security (see migration `_enable_rls_buyer_orders`). Neon: pooled host
# (`-pooler`). If empty, the app falls back to DATABASE_URL (owner) -> RLS inactive.
# Set the role password in the DB: `ALTER ROLE app_user WITH PASSWORD '<secret>';`
APP_DATABASE_URL=""
NEXTAUTH_URL=""
NEXTAUTH_SECRET=""
UPLOADTHING_TOKEN=""
# Admin seed for `prisma db seed`. Format: email|password|name; separate multiple with ;
# Example: ADMIN_SEED="admin@example.com|change-me-to-a-strong-password|Admin Name"
ADMIN_SEED=""
# Set to 1 to bypass the anti-prod guardrail on db:migrate / db:seed
# SKIP_DB_GUARD="0"

# Upstash Redis - login rate limit (issue #334): 10 attempts / 5 min per IP + per identifier.
# Create a database at console.upstash.com (region ap-southeast-1/Singapore, same as the
# Vercel functions and Neon), then fill in the REST URL + token. Empty = limiter disabled (fail-open, login keeps working).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# PostHog browser analytics
# NEXT_PUBLIC_POSTHOG_HOST must go through the own-domain reverse proxy (issue #214):
# production: https://www.curatedbyder.store/ingest  (rewrite in next.config.mjs -> us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://www.curatedbyder.store/ingest

# Sentry error tracking - PRODUCTION ONLY (Vercel scope Production).
# Fill NEXT_PUBLIC_SENTRY_DSN (+ SENTRY_AUTH_TOKEN for source map upload at build)
# ONLY in Vercel Production. Keep empty locally/staging -> Sentry disabled (no-op).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
